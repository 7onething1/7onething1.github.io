<script>
(function(){
  /* plain-word dictionary, whole word, case-insensitive. Expand freely. */
  var KID = {
    midi:"computer music notes", stems:"split-apart song tracks", stem:"song track",
    demucs:"song splitter", ixi:"deep song study", vercel:"the website host",
    deploy:"put online", deployed:"put online", deploying:"putting online",
    dashboard:"info board", hook:"auto-helper", skill:"tool", skills:"tools",
    ntfy:"phone alerts", queue:"to-do list", tarot:"fortune cards",
    songsterr:"guitar-tab site", html:"web page", repo:"code folder",
    cron:"timed robot", launchd:"background robot", daemon:"background robot",
    api:"app link", etsy:"craft shop", gumroad:"online shop", fiverr:"gig shop",
    obsidian:"notes app", transcript:"written recording", ableton:"music app",
    xtts:"computer voice", elevenlabs:"computer voice", deepseek:"helper AI",
    opus:"big helper AI", sonnet:"helper AI", haiku:"small helper AI",
    chord:"music chord", chords:"music chords", handoff:"pass-along note",
    session:"chat", workflow:"auto task chain", n8n:"auto task app",
    webm:"video file", mp4:"video file", render:"build the video",
    cdn:"file server", commit:"save point", slug:"page name",
    /* shop / CEO words so business pages read plainly too */
    listing:"shop item", listings:"shop items", revenue:"money made",
    conversion:"buying", sku:"product code", seo:"search words",
    keyword:"search word", keywords:"search words", margin:"money kept",
    pricing:"prices", monetization:"making money", monetize:"make money",
    inventory:"the stuff for sale", portfolio:"the whole set",
    funnel:"buying path", catalog:"the product list", thumbnail:"cover picture",
    impressions:"times shown", checkout:"the paying step", upsell:"add-on offer",
    audit:"check-up", verdict:"the call", roi:"money back", kpi:"key number"
  };
  function kidifyText(s){
    if(!s) return s;
    return s.replace(/[A-Za-z][A-Za-z0-9'\-]*/g, function(w){
      var h = KID[w.toLowerCase()];
      if(!h) return w;
      // keep capitalization of the first letter
      return (w[0] === w[0].toUpperCase()) ? h.charAt(0).toUpperCase()+h.slice(1) : h;
    });
  }
  var SKIP = {SCRIPT:1,STYLE:1,CODE:1,PRE:1,TEXTAREA:1,KBD:1,SAMP:1,NOSCRIPT:1};
  var nodes = [];            // {node, original}
  var els   = [];            // {el, originalText, kidText} for data-kid overrides
  function collect(){
    nodes = []; els = [];
    var btn = document.getElementById('mode-btn');
    var walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode:function(n){
        if(!n.nodeValue || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        var p = n.parentNode;
        while(p && p !== document.body){
          if(p === btn) return NodeFilter.FILTER_REJECT;
          if(SKIP[p.nodeName]) return NodeFilter.FILTER_REJECT;
          if(p.classList && (p.classList.contains('nokid') || p.hasAttribute('data-no-kid')))
            return NodeFilter.FILTER_REJECT;
          p = p.parentNode;
        }
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var n; while((n = walk.nextNode())) nodes.push({node:n, original:n.nodeValue});
    var list = document.querySelectorAll('[data-kid]');
    for(var i=0;i<list.length;i++){
      els.push({el:list[i], originalText:list[i].textContent, kidText:list[i].getAttribute('data-kid')});
    }
  }
  window.kidRecollect = collect;   // call after dynamic re-renders
  function apply(on){
    if(!nodes.length && !els.length) collect();
    for(var i=0;i<nodes.length;i++){
      nodes[i].node.nodeValue = on ? kidifyText(nodes[i].original) : nodes[i].original;
    }
    for(var j=0;j<els.length;j++){
      els[j].el.textContent = on ? els[j].kidText : els[j].originalText;
    }
  }
  window.toggleKid = function(){
    var on = !document.body.classList.contains('kids');
    document.body.classList.toggle('kids', on);
    var b = document.getElementById('mode-btn');
    if(b){ b.textContent = on ? '🧑‍🏫 Grown-up mode' : '🧒 Kid mode';
           b.setAttribute('aria-pressed', on ? 'true' : 'false'); }
    apply(on);
    try{ localStorage.setItem('kidmode', on ? '1' : '0'); }catch(e){}
  };
  function boot(){
    collect();
    /* per-page product override: set window.KID_PRODUCT before this block */
    var shop = document.getElementById('kid-shop');
    if(shop && window.KID_PRODUCT){ shop.href = window.KID_PRODUCT; }
    var saved = '0';
    try{ saved = localStorage.getItem('kidmode') || '0'; }catch(e){}
    if(saved === '1' || /[?&]kid=1\b/.test(location.search) || location.hash === '#kid'){
      document.body.classList.add('kids');
      var b = document.getElementById('mode-btn');
      if(b){ b.textContent = '🧑‍🏫 Grown-up mode'; b.setAttribute('aria-pressed','true'); }
      apply(true);
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
