   scroller and cap it at the viewport, so it reads without any sideways scrolling. */
.dk-panel{position:sticky;left:14px;box-sizing:border-box;
  width:min(1080px,calc(100vw - 44px));
  border:1px solid #d9c9a6;border-left:4px solid #5B8C8A;border-radius:8px;
  background:#fff;padding:12px 14px}
.dk-head{font:700 12px/1.4 Inter,system-ui,sans-serif;color:#3f3a30;margin:0 0 2px}
.dk-note{font:400 11.5px/1.5 Inter,system-ui,sans-serif;color:#7c7059;margin:0 0 10px}
.dk-list{list-style:none;margin:0;padding:0;display:grid;gap:6px;
  grid-template-columns:repeat(auto-fill,minmax(310px,1fr))}
.dk-item{display:flex;gap:9px;align-items:flex-start;padding:7px 9px;border:1px solid #eadfc6;
  border-radius:6px;background:#FFFCF4}
.dk-qty{flex:0 0 auto;font:700 11px/1.5 ui-monospace,Menlo,monospace;color:#fff;background:#8a6f4b;
  border-radius:4px;padding:1px 6px;margin-top:1px}
.dk-qty[data-q="4"]{background:#5B8C8A}
.dk-meta{min-width:0}
.dk-title{font:600 12px/1.35 Inter,system-ui,sans-serif;color:#2f2b24;
  overflow-wrap:anywhere;display:block;text-decoration:none}
a.dk-title:hover{color:#5B8C8A;text-decoration:underline}
.dk-sub{font:400 11px/1.45 Inter,system-ui,sans-serif;color:#7c7059;margin-top:2px}
.dk-ci{font:700 10px/1 ui-monospace,Menlo,monospace;letter-spacing:.06em;color:#6b6250}
@media (max-width:640px){.dk-list{grid-template-columns:1fr}}
</style>

<script>
/* Decks that play a card: opened on demand from #dk-data, the same pool the printed
   N / TOTAL count was measured from. One open panel per row, and the panel is a real
   sibling row carrying the owner's classes, so the land / owned / rotating filters
   hide it with its card and a re-sort keeps it attached. */
(function(){
  var el = document.getElementById('dk-data');
  if(!el) return;
  var DK = JSON.parse(el.textContent);
  var MARK = 'dk-panel-host';
  var esc = function(s){ return String(s == null ? '' : s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); };

  function deckHTML(d, qty){
    var bits = [];
    if(d.c) bits.push(esc(d.c));
    if(d.a) bits.push(esc(d.a));
    if(d.wc != null) bits.push(esc(d.wc) + ' rare/mythic WC to build');
    if(d.usd != null) bits.push('$' + Number(d.usd).toFixed(2) + ' paper');
    var link = d.v ? 'https://youtu.be/' + encodeURIComponent(d.v) : (d.mox || '');
    var title = link
      ? '<a class="dk-title" href="' + esc(link) + '" target="_blank" rel="noopener">' + esc(d.t) + '</a>'
      : '<span class="dk-title">' + esc(d.t) + '</span>';
    return '<li class="dk-item"><span class="dk-qty" data-q="' + esc(qty) + '">' + esc(qty) + 'x</span>' +
           '<span class="dk-meta">' + title +
           '<span class="dk-sub"><span class="dk-ci">' + esc(d.col) + '</span>' +
           (bits.length ? ' &middot; ' + bits.join(' &middot; ') : '') + '</span></span></li>';
  }

  function panelHTML(pool, hits, name){
    var P = DK.pools[pool];
    var scope = (pool === 'm') ? 'Mardu-color' : 'Standard';
    var head = hits.length + ' of the ' + P.total + ' harvested ' + scope +
               ' decks run ' + esc(name) + '.';
    if(!hits.length){
      return '<div class="dk-panel"><p class="dk-head">' + head + '</p>' +
             '<p class="dk-note">No list in this pool runs it, so there is nothing to ' +
             'open.</p></div>';
    }
    var four = 0, i;
    for(i = 0; i < hits.length; i++){ if(hits[i][1] >= 4) four++; }
    var note = four + ' of them run a full playset of 4. The copies badge is the most any ' +
               'one list runs. The count beside the row counts decks, so a list running a ' +
               'single copy weighs the same as a list running four. Titles link to the ' +
               'creator video each list came from.';
    var out = '';
    for(i = 0; i < hits.length; i++){ out += deckHTML(P.decks[hits[i][0]], hits[i][1]); }
    return '<div class="dk-panel"><p class="dk-head">' + head + '</p>' +
           '<p class="dk-note">' + note + '</p><ul class="dk-list">' + out + '</ul></div>';
  }

  window.dkToggle = function(btn){
    var row = btn.closest('tr');
    var open = btn.getAttribute('aria-expanded') === 'true';
    var next = row.nextElementSibling;
    if(open){
      if(next && next.classList.contains('dk-row')) next.remove();
      btn.setAttribute('aria-expanded','false');
      return;
    }
    var pool = btn.dataset.pool, card = btn.dataset.card;
    var hits = (DK.cards[pool] && DK.cards[pool][card]) || [];
    var nameCell = row.children[1];
    var name = nameCell ? nameCell.textContent.trim() : card;
    var tr = document.createElement('tr');
    tr.className = row.className + ' dk-row ' + MARK;
    tr.setAttribute('data-owner', pool + '|' + card);
    var td = document.createElement('td');
    td.colSpan = row.children.length;
    td.innerHTML = panelHTML(pool, hits, name);
    tr.appendChild(td);
    row.parentNode.insertBefore(tr, row.nextSibling);
    btn.setAttribute('aria-expanded','true');
  };

  /* A sort appends every <tr> in body order, which would leave open panels stranded
     at the bottom. Re-anchor each one to its own row after any sort. */
  if(typeof window.sortRanking === 'function'){
    var inner = window.sortRanking;
    window.sortRanking = function(){
      var r = inner.apply(this, arguments);
      document.querySelectorAll('#ranking-table button.dk-btn[aria-expanded="true"]')
        .forEach(function(b){
          var own = b.closest('tr');
          var pan = own.parentNode.querySelector('tr.dk-row[data-owner="' + b.dataset.pool + '|' + b.dataset.card + '"]');
          if(pan && own.nextElementSibling !== pan) own.parentNode.insertBefore(pan, own.nextSibling);
        });
      return r;
    };
  }
  document.addEventListener('keydown', function(e){
    if(e.key !== 'Escape') return;
    document.querySelectorAll('#ranking-table button.dk-btn[aria-expanded="true"]')
      .forEach(function(b){ window.dkToggle(b); });
  });
})();
</script>

</body>
</html>
