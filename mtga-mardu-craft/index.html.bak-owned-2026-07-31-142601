        var k = {'arch-sort-wr':'wr','arch-sort-shared':'shared','arch-sort-wc':'wc'}[active.id] || 'wc';
        window.sortArch(k);
      }
      if (window.renderSharedBadges) window.renderSharedBadges();
    }
    // NOTE: "Decks that run it" (column 9) counts OBSERVED PLAY: how many real
    // Mardu-color Standard decklists actually list the card. Recomputed by
    // recount_observed_play.py against deck_costs.json, not live in this JS.
    // The older color-identity 'can play' measure was dropped 2026-07-30: 60 of
    // 76 cards tied at the maximum under it, so it ranked nothing.
    setText('last-updated', 'Last updated: ' + fmtTime(d.updated));
    if (window.kidRecollect) window.kidRecollect(); // re-index for kid mode
  }
  window.refreshData = function(){
    var btn = document.getElementById('btn-refresh');
    var old = btn ? btn.innerHTML : '';
    if (btn){ btn.disabled = true; btn.innerHTML = '&#8635; Updating'; }
    // ABSOLUTE path, not './data.json'. Vercel serves this page at /mtga-mardu-craft
    // with NO trailing slash, so a relative fetch resolves to /data.json, which is a
    // 404 that returns the HTML error page. The button then died on
    // "Unexpected token '<'" every single press. Verified 2026-07-31:
    //   ./data.json               -> /data.json               404 text/html
    //   /mtga-mardu-craft/data.json -> 200 application/json
    fetch('/mtga-mardu-craft/data.json?t=' + Date.now(), {cache:'no-store'})
      .then(function(r){
        if(!r.ok) throw new Error('HTTP ' + r.status);
        var ct = r.headers.get('content-type') || '';
        if(ct.indexOf('json') < 0) throw new Error('got ' + ct + ', not JSON');
        return r.json();
      })
      .then(function(d){ applyData(d); toast('Updated from latest data (' + fmtTime(d.updated) + ')'); })
      .catch(function(e){ toast('Could not load latest data: ' + e.message); })
      .finally(function(){ if (btn){ btn.disabled = false; btn.innerHTML = old; } });
  };
</script>

