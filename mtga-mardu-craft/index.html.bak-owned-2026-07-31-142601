<script>
/* CD-JS:START */
/* --- creator decks: filter + sort --- */
  var cdWedgeOnly=false, cdPricedOnly=false, cdMarduOnly=false;
  function cdApply(){
    var rows=document.querySelectorAll('#cd-body tr.cd-row'), shown=0;
    rows.forEach(function(r){
      var ok=true;
      var w=r.dataset.wedge;
      if(cdWedgeOnly && w!=='in' && w!=='mardu') ok=false;
      if(cdMarduOnly && w!=='mardu') ok=false;
      if(cdPricedOnly && r.dataset.priced!=='1') ok=false;
      r.classList.toggle('cd-hidden', !ok);
      if(ok) shown++;
    });
    var c=document.getElementById('cd-shown');
    if(c) c.textContent=shown+' of '+rows.length;
  }
  function cdToggleWedge(){cdWedgeOnly=!cdWedgeOnly;document.getElementById('cd-only-wedge').classList.toggle('on',cdWedgeOnly);cdApply();}
  function cdToggleMardu(){cdMarduOnly=!cdMarduOnly;document.getElementById('cd-only-mardu').classList.toggle('on',cdMarduOnly);cdApply();}
  function cdTogglePriced(){cdPricedOnly=!cdPricedOnly;document.getElementById('cd-only-priced').classList.toggle('on',cdPricedOnly);cdApply();}
  function cdSort(mode){
    var body=document.getElementById('cd-body');
    if(!body) return;
    var rows=Array.prototype.slice.call(body.querySelectorAll('tr.cd-row'));
    var rank={'mardu':0,'in':1,'unk':2,'out':3};
    rows.sort(function(a,b){
      var pa=parseFloat(a.querySelector('td[data-price]').dataset.price);
      var pb=parseFloat(b.querySelector('td[data-price]').dataset.price);
      var wa=parseFloat(a.querySelector('td[data-wc]').dataset.wc);
      var wb=parseFloat(b.querySelector('td[data-wc]').dataset.wc);
      if(mode==='price'){
        if(pa<0&&pb<0) return 0;
        if(pa<0) return 1;
        if(pb<0) return -1;
        return pa-pb;
      }
      if(mode==='wc'){
        if(wa<0&&wb<0) return 0;
        if(wa<0) return 1;
        if(wb<0) return -1;
        return wa-wb;
      }
      if(mode==='creator'){
        return a.cells[0].textContent.localeCompare(b.cells[0].textContent);
      }
      var d=rank[a.dataset.wedge]-rank[b.dataset.wedge];
      if(d) return d;
      var sa=(pa<0)?1:0, sb=(pb<0)?1:0;
      if(sa!==sb) return sa-sb;
      if(pa>=0&&pb>=0&&pa!==pb) return pa-pb;
      return a.cells[0].textContent.localeCompare(b.cells[0].textContent);
    });
    rows.forEach(function(r){body.appendChild(r);});
    document.querySelectorAll('.cd-sort-btn').forEach(function(b){b.classList.remove('on');});
    var btn=document.getElementById('cd-sort-'+mode);
    if(btn) btn.classList.add('on');
  }
  /* CD-JS:END */
  function toggleLands(){
    document.body.classList.toggle('hide-lands');
    document.getElementById('toggle-lands').classList.toggle('on');
  }
  function toggleOwned(){
    document.body.classList.toggle('hide-owned');
    document.getElementById('toggle-owned').classList.toggle('on');
  }
  function toggleRotating(){
    document.body.classList.toggle('hide-rotating');
    document.getElementById('toggle-rotating').classList.toggle('on');
  }

  // Rotation is decided per CARD at build time by tag_rotation_2027.py, which reads
  // every printing Scryfall lists and marks a row data-rotates="1" only when the card
  // has NO home in a set that survives the early-2027 rotation. This used to match the
  // displayed Set column against a hardcoded {WOE, LCI}, which was wrong twice over:
  // the 2027 rotation retires seven sets (WOE LCI MKM OTJ BIG BLB DSK), and a card
  // shown in a rotating set but reprinted into a surviving one does not rotate at all.
  (function(){
    var table = document.getElementById('ranking-table');
    if(!table) return;
    var rows = table.querySelectorAll('tbody tr[data-rotates="1"]');
    for(var i=0;i<rows.length;i++){ rows[i].classList.add('row-rotating'); }
  })();

  // sortable card table — one engine shared by column headers AND sort buttons
  (function(){
    const table = document.getElementById('ranking-table');
    if (!table) return;
    const ths = table.querySelectorAll('thead th');
    let lastCol = 9, lastDir = -1;
    function cellValue(td, col){
      const txt = td.textContent.trim();
      if (col === 9) {
        const m = txt.match(/(\d+)\s*\/\s*55/);
        return m ? parseInt(m[1], 10) : 0;
      }
      if (col === 10) {
        const m = txt.match(/([\d.]+)/);
        return m ? parseFloat(m[1]) : -1;   // n/a sinks to the bottom
      }
      if (col === 7) {
        return parseInt(txt, 10) || 0;
      }
      if (col === 8) {
        const m = txt.match(/^(\d+)/);
        return m ? parseInt(m[1], 10) : 0;
      }
      if (col === 0) return parseInt(txt, 10) || 0;
      return txt.toLowerCase();
    }
    window.sortRanking = function(col, forceDir){
      const dir = (typeof forceDir === 'number') ? forceDir
                : ((col === lastCol) ? -lastDir : -1);
      lastCol = col; lastDir = dir;
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr:not(.dk-row)'));
      rows.sort((a, b) => {
        const va = cellValue(a.children[col], col);
        const vb = cellValue(b.children[col], col);
        if (va < vb) return -dir;
        if (va > vb) return dir;
        return 0;
      });
      rows.forEach(r => tbody.appendChild(r));
      ths.forEach(h => h.querySelector('.sort-arrow')?.remove());
      const th = ths[col];
      if (th) {
        const arrow = document.createElement('span');
        arrow.className = 'sort-arrow';
        arrow.textContent = dir > 0 ? '^' : 'v';
        th.appendChild(arrow);
      }
      document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('on'));
      const map = {8:'sort-wc', 9:'sort-decks'};
      if (map[col]) { const btn = document.getElementById(map[col]); if (btn) btn.classList.add('on'); }
    };
    ths.forEach(th => {
      th.addEventListener('click', () => window.sortRanking(parseInt(th.dataset.col, 10)));
    });
    window.sortRanking(8, -1); // default sort: Wildcards needed, descending (most needed first)
  })();

  // "Wildcards needed" button: toggle fewest-to-finish (ascending) <-> most (descending).
  // Default ascending so it visibly reorders away from the deck-count default view.
  (function(){
    var dir = 1; // +1 ascending = cheapest playset to finish first
    window.sortWildcards = function(){ window.sortRanking(8, dir); dir = -dir; };
  })();

  // sort the 25-deck archetype grid (win rate is per-deck, so it sorts HERE)
  (function(){
    const grid = document.querySelector('.arch-grid');
    if (!grid) return;
    function wr(c){ const e = c.querySelector('.wr'); const m = e ? e.textContent.match(/([\d.]+)/) : null; return m ? parseFloat(m[1]) : 0; }
    function matches(c){ const m = c.textContent.match(/([\d,]+)\s*matches/); return m ? parseInt(m[1].replace(/,/g,''), 10) : 0; }
    // color identity of a card / deck -> WUBRG mask (W=1,B=4,R=8; no U/G in Mardu)
    function toMask(ci){ var m=0; if(ci.indexOf('W')>-1)m|=1; if(ci.indexOf('B')>-1)m|=4; if(ci.indexOf('R')>-1)m|=8; return m; }
    function deckMask(cell){
      var d = cell.children[1] ? cell.children[1].textContent.trim() : '';
      var t = d.match(/^[WUBRG]+/); return t ? toMask(t[0]) : 0;
    }
    // the still-needed wildcard crafts: every card row with WC-to-4-of > 0,
    // each carrying its "demand" = how many of the 55 decks actually run it (the Decks column)
    function craftCands(){
      var rows = document.querySelectorAll('#ranking-table tbody tr'), list = [];
      rows.forEach(function(tr){
        var wcM = (tr.children[8] ? tr.children[8].textContent.trim() : '0').match(/^(\d+)/);
        var wc = wcM ? parseInt(wcM[1], 10) : 0;
        if (wc > 0){
          var ci = tr.children[2] ? tr.children[2].textContent.trim() : 'C';
          var dm = (tr.children[9] ? tr.children[9].textContent : '').match(/(\d+)\s*\/\s*\d+/);
          list.push({ mask: (ci === 'C' ? 0 : toMask(ci)), demand: dm ? parseInt(dm[1], 10) : 0, wc: wc });
        }
      });
      return list;
    }
    // shared-craft score: sum over the craft cards THIS deck can run of how many
    // OTHER decks also need that card (demand - 1). Higher = crafts you make for
    // this deck do the most double-duty across the rest of the list.
    // a deck's strategy archetype = its name with the color/guild prefix stripped,
    // so "Mono-Black Skeletons" and "Orzhov Skeletons" are the SAME archetype (Skeletons)
    function deckStrategy(cell){
      var nm = cell.children[0] ? cell.children[0].textContent.trim() : '';
      return nm.replace(/^(Mono-White|Mono-Black|Mono-Red|Mono-Blue|Mono-Green|Orzhov|Boros|Rakdos|Azorius|Dimir|Golgari|Gruul|Izzet|Selesnya|Simic|Mardu|Jeskai|Sultai|Abzan|Temur|Naya|Bant|Esper|Grixis|Jund)\s+/i, '').toLowerCase();
    }
    function deckList(cells){ return cells.map(function(c){ return { strat: deckStrategy(c), mask: deckMask(c) }; }); }
    // most-shared-crafts score = how many distinct archetypes (deduped by name) whose
    // color identity this deck can fully run, i.e. whose wildcard crafts this deck contains.
    // Counts decks BY ARCHETYPE, not raw decks, so it lands on the scale of the deck count.
    function sharedScore(cell, list){
      var dm = deckMask(cell), seen = {};
      for (var i=0;i<list.length;i++){ if ((list[i].mask & dm) === list[i].mask) seen[list[i].strat] = 1; }
      return Object.keys(seen).length;
    }
    // total wildcards to finish every still-needed card this deck can run
    function deckWildcards(cell, cands){
      var dm = deckMask(cell), s = 0;
      for (var i=0;i<cands.length;i++){ var c = cands[i]; if ((dm & c.mask) === c.mask) s += c.wc; }
      return s;
    }
    // Split a deck's wildcards-to-finish into reusable vs color-specific:
    //  shared   = WC on colorless crafts (legal in ANY deck, so they help other decks)
    //  specific = WC on colored crafts (this deck's dual lands, tied to its colors)
    function wcSplit(cell, cands){
      var dm = deckMask(cell), shared = 0, specific = 0;
      for (var i=0;i<cands.length;i++){
        var c = cands[i];
        if ((dm & c.mask) === c.mask){ if (c.mask === 0) shared += c.wc; else specific += c.wc; }
      }
      return { shared: shared, specific: specific, total: shared + specific };
    }
    window.sortArchDir = window.sortArchDir || { wc: 1 }; // wc toggles fewest<->most
    window.sortArch = function(key){
      const cells = Array.from(grid.querySelectorAll('.arch-cell')); // re-query: grid may have been rebuilt by Update
      const cands = (key === 'wc') ? craftCands() : null;
      function keyOf(c){
        if (key === 'wr') return wr(c);
        if (key === 'matches') return matches(c);
        return deckWildcards(c, cands); // wc
      }
      var asc = (key === 'wc') && (window.sortArchDir.wc === 1); // wc default = fewest first
      cells.sort((a, b) => asc ? (keyOf(a) - keyOf(b)) : (keyOf(b) - keyOf(a)));
      cells.forEach(function(c){
        if (key === 'wc'){
          c.title = 'Wildcards to finish: ' + deckWildcards(c, cands)
                  + ' total WCs to craft every card you still need that this deck can run';
        } else if (key !== 'shared'){ c.removeAttribute('title'); }
        grid.appendChild(c);
      });
      document.querySelectorAll('.arch-sort-btn').forEach(b => b.classList.remove('on'));
      const map = { wr:'arch-sort-wr', matches:'arch-sort-matches', shared:'arch-sort-shared', wc:'arch-sort-wc' };
      const btn = document.getElementById(map[key]); if (btn) btn.classList.add('on');
    };
    // wc button click: apply current direction, THEN flip for the next click.
    // Programmatic re-sorts (Update re-render, boot) call sortArch('wc') directly so they never flip.
    window.toggleDeckWC = function(){ window.sortArch('wc'); window.sortArchDir.wc = -window.sortArchDir.wc; };
    // Append each deck's total wildcards-to-finish to its detail line (no badge)
    window.renderSharedBadges = function(){
      var cells = Array.from(grid.querySelectorAll('.arch-cell'));
      var cands = craftCands();
      cells.forEach(function(c){
        var oldBadge = c.querySelector('.shared-num'); if (oldBadge) oldBadge.remove();
        var detail = c.children[1];
        if (detail){
          var w = detail.querySelector('.wc-finish');
          if (!w){ w = document.createElement('span'); w.className = 'wc-finish'; detail.appendChild(w); }
          w.innerHTML = ' &middot; <b>' + deckWildcards(c, cands) + ' WC to finish</b>';
        }
      });
    };
    // default view: sort the grid by wildcards-to-finish (the default-on button)
    window.sortArch('wc');
    window.sortArchDir.wc = -1; // so the first user click flips to most-first (visible change)
    window.renderSharedBadges();
  })();

  // ===== Live-data Update button =====
  // Re-fetches ./data.json and re-renders the KPI tiles and the archetype
  // grid. The deck-count column is NOT touched here: it is baked by
  // recount_observed_play.py from real decklists. Goes live the
  // instant data.json is refreshed by a pull. Collection side (Owned/WC) is
  // private to your Untapped login, so it updates on the next pull, not here.
  function setText(id, v){ var el = document.getElementById(id); if (el) el.textContent = v; }
  function esc(s){ return String(s).replace(/[&<>]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c]; }); }
  function cbToCI(cb){ var s=''; if(cb&1)s+='W'; if(cb&2)s+='U'; if(cb&4)s+='B'; if(cb&8)s+='R'; if(cb&16)s+='G'; return s||'C'; }
  function ciToMask(ci){ if(!ci||ci==='C') return 0; var m=0; if(ci.indexOf('W')>-1)m|=1; if(ci.indexOf('B')>-1)m|=4; if(ci.indexOf('R')>-1)m|=8; return m; }
  function fmtTime(iso){ try{ return new Date(iso).toLocaleString(); }catch(e){ return iso; } }
  function toast(msg){
    var t = document.createElement('div'); t.className = 'mtga-toast'; t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(function(){ t.classList.add('show'); });
    setTimeout(function(){ t.classList.remove('show'); setTimeout(function(){ t.remove(); }, 350); }, 2600);
  }
  function applyData(d){
    var R = d.resources || {};
    setText('kpi-rare', R.rare_wc);
    setText('kpi-mythic', R.mythic_wc);
    setText('kpi-decks', R.deck_count);
    if (R.best_mardu_wr != null){
      setText('kpi-bestwr', R.best_mardu_wr.toFixed(1) + '%');
      setText('kpi-bestwr-sub', R.best_mardu_deck + ', ' + R.best_mardu_matches + ' matches');
    }
    if (R.collection_owned != null){
      setText('kpi-coll', Number(R.collection_owned).toLocaleString());
      setText('kpi-coll-sub', R.collection_copies != null
        ? 'distinct cards, ' + Number(R.collection_copies).toLocaleString() + ' copies'
        : 'distinct cards');
    }
    if (R.gems != null){
      setText('kpi-gems', Number(R.gems).toLocaleString());
      setText('kpi-gold-sub', 'gold: ' + Number(R.gold).toLocaleString());
    }
    // rebuild the 25-deck grid
    var archs = d.archetypes || [];
    var grid = document.querySelector('.arch-grid');
    if (grid && archs.length){
      grid.innerHTML = archs.map(function(a){
        var top = (a.wr >= 55.0) ? ' top-wr' : '';
        return '<div class="arch-cell' + top + '"><div class="nm">' + esc(a.label) + '</div>'
             + '<div>' + cbToCI(a.cb) + ' &middot; ' + a.matches + ' matches &middot; '
