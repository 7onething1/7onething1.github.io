  })();

  // ---- Collapsible explainers: each H2's prose hides behind a "what this is" button ----
  // Default collapsed. Only the explanatory .sub/.note prose collapses; the working
  // widgets (KPIs, filters, tables, deck grid) stay visible.
  (function(){
    var EXPL = '.sub, .note';
    document.querySelectorAll('h2').forEach(function(h){
      var items = [], n = h.nextElementSibling;
      while (n && n.tagName !== 'H2'){
        if (n.matches && n.matches(EXPL) && !n.classList.contains('footer')) items.push(n);
        n = n.nextElementSibling;
      }
      if (!items.length) return;
      var box = document.createElement('div'); box.className = 'explainer-box';
      h.after(box);
      items.forEach(function(el){ box.appendChild(el); }); // cluster the prose under the heading
      var btn = document.createElement('button');
      btn.className = 'explainer-btn'; btn.type = 'button';
      h.appendChild(document.createTextNode(' '));
      h.appendChild(btn);
      function set(open){
        box.style.display = open ? '' : 'none';
        btn.textContent = (open ? '▾' : '▸') + ' what this is';
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      set(false); // default collapsed
      btn.addEventListener('click', function(){ set(box.style.display === 'none'); });
    });
  })();
</script>


