  .ci-BW,.ci-WB{background:linear-gradient(90deg,#fffcf2 50%,#3a3133 50%);color:#7a2c0f}
  .ci-RW,.ci-WR{background:linear-gradient(90deg,#fffcf2 50%,#f5cdb4 50%);color:#7a2c0f}
