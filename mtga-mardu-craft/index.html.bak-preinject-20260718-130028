  .controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:12px 16px;margin:18px 0;box-shadow:3px 3px 0 rgba(43,39,35,.18)}
