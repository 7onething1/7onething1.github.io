        return r.json();
      })
      .then(function(d){ applyData(d); toast('Updated from latest data (' + fmtTime(d.updated) + ')'); })
      .catch(function(e){ toast('Could not load latest data: ' + e.message); })
      .finally(function(){ if (btn){ btn.disabled = false; btn.innerHTML = old; } });
  };
</script>

<script>
  // ---- Click a card thumbnail to pop it up large, in page ----
  // Thumbnails are baked Untapped art (data-big = the 512px version). One shared overlay.
  (function(){
    var ov = document.createElement('div'); ov.className = 'card-lightbox'; ov.id = 'card-lightbox';
    ov.innerHTML = '<img alt="">';
    ov.addEventListener('click', function(){ ov.classList.remove('show'); });
    document.body.appendChild(ov);
    var big = ov.querySelector('img');
    document.addEventListener('click', function(e){
      var t = e.target;
      if (t && t.classList && t.classList.contains('card-thumb')){
        var src = t.getAttribute('data-big') || t.src;
        big.src = src; ov.classList.add('show');
      }
    });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') ov.classList.remove('show'); });
  })();

  // ---- Collapsible explainers: each H2's prose hides behind a "what this is" button ----
  // Default collapsed. Only the explanatory .sub/.note prose collapses; the working
  // widgets (KPIs, filters, tables, deck grid) stay visible.
  (function(){
    var EXPL = '.sub, .note';
    document.querySelectorAll('h2').forEach(function(h){
      var items = [], n = h.nextElementSibling;
      while (n && n.tagName !== 'H2'){
        if (n.matches && n.matches(EXPL) && !n.classList.contains('footer')) items.push(n);
        n = n.nextElementSibling;
      }
      if (!items.length) return;
      var box = document.createElement('div'); box.className = 'explainer-box';
      h.after(box);
      items.forEach(function(el){ box.appendChild(el); }); // cluster the prose under the heading
      var btn = document.createElement('button');
      btn.className = 'explainer-btn'; btn.type = 'button';
      h.appendChild(document.createTextNode(' '));
      h.appendChild(btn);
      function set(open){
        box.style.display = open ? '' : 'none';
        btn.textContent = (open ? '▾' : '▸') + ' what this is';
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      set(false); // default collapsed
      btn.addEventListener('click', function(){ set(box.style.display === 'none'); });
    });
  })();
</script>


























