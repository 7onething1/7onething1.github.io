<script>
// Four variants per board, not a row filter. Hiding non-Hobbit rows out of a fixed
// top 25 and top 20 showed 4 and ZERO, because a leaderboard minus most of its rows is
// not a leaderboard of what is left. Each variant is ranked from the whole pool.
var TBMODE='all', TBHOB=false;
function tbShow(){
  var want = (TBHOB ? 'h' : '') + TBMODE;
  [['all','tb-m-all'],['spells','tb-m-spells'],['hall','tb-m-hall'],['hspells','tb-m-hspells']]
    .forEach(function(p){
      document.querySelectorAll('#top-builds .'+p[1]).forEach(function(e){ e.hidden = (p[0]!==want); });
    });
  document.getElementById('tb-all').classList.toggle('on', TBMODE==='all');
  document.getElementById('tb-spells').classList.toggle('on', TBMODE==='spells');
  document.getElementById('tb-hob').classList.toggle('on', TBHOB);
  document.getElementById('tb-hint').textContent =
    (TBHOB ? 'Hobbit decks only, both boards re-ranked from every deck that runs a card new in The Hobbit. ' : '')
    + ((TBMODE==='all')
      ? "Lands are counted. They are most of a deck's wildcard cost and you reuse them across builds."
      : "Lands dropped from both the wildcard count and the price, and both boards re-ranked on spells alone.");
}
function tbHob(){ TBHOB=!TBHOB; tbShow(); }
// Sort either board by either column. Reads data-k, the raw number, never the rendered
// cell: the money cell renders as "$1,234" inside a buy link, and a text sort would put
// $9 after $1,234. Clicking the same header again reverses it. The rank column is
// renumbered after every sort so "#" always means position in the order on screen.
function tbSort(th, col){
  var tbl = th.closest('table'), tb = tbl.tBodies[0];
  var asc = th.dataset.dir !== 'asc';
  tbl.querySelectorAll('th.tbsort').forEach(function(h){
    h.dataset.dir=''; var a=h.querySelector('.tbarrow'); if(a) a.textContent='';
  });
  th.dataset.dir = asc ? 'asc' : 'desc';
  var ar = th.querySelector('.tbarrow'); if(ar) ar.textContent = asc ? ' ↑' : ' ↓';
  var rows = Array.prototype.slice.call(tb.rows);
  rows.sort(function(x, y){
    var a = parseFloat(x.cells[col] && x.cells[col].dataset.k);
    var b = parseFloat(y.cells[col] && y.cells[col].dataset.k);
    if (isNaN(a)) a = Infinity; if (isNaN(b)) b = Infinity;
    return asc ? a - b : b - a;
  });
  rows.forEach(function(r, i){ if(r.cells[0]) r.cells[0].textContent = i + 1; tb.appendChild(r); });
}
function tbMode(m){ TBMODE=m; tbShow(); }
</script>
