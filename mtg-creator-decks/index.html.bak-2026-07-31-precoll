    // highlight anything published in the last 7 days
    var p=c.getAttribute('data-pub');
    c.classList.toggle('fresh', p!=='' && parseInt(p,10)>=CUTOFF);
  });
  document.querySelectorAll('.creator').forEach(function(s){
    s.style.display = (SORT!=='creator') ? 'none'
      : (s.querySelectorAll('.card:not(.hide)').length? '' : 'none');
  });
  var aff=CARDS.filter(function(c){return c.classList.contains('afford') && !c.classList.contains('hide');}).length;
  document.getElementById('shown').textContent = n+' decks shown · '+aff+' fit the budget';
}

function ts(b){
  SORT=b.dataset.sort;
  document.querySelectorAll('.sbtn').forEach(function(x){x.classList.toggle('on',x===b);});
  var flat=document.getElementById('flat');
  // the per-creator bars only mean something while the creator grouping is on screen
  document.body.classList.toggle('flatsort', SORT!=='creator');
  if(SORT==='creator'){
    flat.style.display='none';
    // CARDS is in document order, so re-homing restores each grid's original order
    CARDS.forEach(function(c){ c._home.appendChild(c); });
    document.querySelectorAll('.csbtn').forEach(function(x){
      x.classList.toggle('on', x.dataset.csort==='def');
    });
  } else {
    flat.style.display='';
    // decks with a real value sort first; decks missing it always sink to the bottom
    var key = (SORT==='price') ? 'data-price' : (SORT==='rm' ? 'data-rm' : 'data-pub');
    var desc = (SORT==='pub');           // newest first, everything else smallest first
    var have=[], none=[];
    CARDS.forEach(function(c){ (c.getAttribute(key)!=='' ? have : none).push(c); });
    have.sort(function(a,b){
      var x=parseFloat(a.getAttribute(key)), y=parseFloat(b.getAttribute(key));
      return desc ? (y-x) : (x-y);
    });
    have.concat(none).forEach(function(c){ flat.appendChild(c); });
  }
  apply();
}
function tc(b){var c=b.dataset.color; if(OFFC.has(c)){OFFC.delete(c);b.classList.remove('off');}else{OFFC.add(c);b.classList.add('off');} apply();}
function callc(on){OFFC.clear(); if(!on){"WUBRG".split('').forEach(function(c){OFFC.add(c);});}
  document.querySelectorAll('.cbtn').forEach(function(b){b.classList.toggle('off',!on);}); apply();}
function tcat(b){var c=b.dataset.cat; if(SELCAT.has(c)){SELCAT.delete(c);b.classList.remove('on');}else{SELCAT.add(c);b.classList.add('on');} apply();}
apply();
</script>
