.lab{font:700 10px/1 "JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.cbtn{width:34px;height:34px;border-radius:50%;border:2px solid #2b2723;font:800 13px "JetBrains Mono",monospace;cursor:pointer;background:#fff}
.cbtn.W{background:#f3e4a8}.cbtn.U{background:#9ec9e8}.cbtn.B{background:#c7b6d9}.cbtn.R{background:#e8a08a}.cbtn.G{background:#9bc99a}
.cbtn.off{opacity:.28;filter:grayscale(.6)}
.allb{font:700 10px/1 "JetBrains Mono",monospace;letter-spacing:.08em;text-transform:uppercase;
  border:1.5px solid var(--line);background:#fff;color:var(--dim);border-radius:999px;padding:8px 10px;cursor:pointer}
.allb:hover{border-color:var(--ink);color:var(--ink)}
.catbtn{font:600 12px/1 Inter;border:1.5px solid var(--c);color:var(--c);background:#fff;border-radius:999px;padding:7px 13px;cursor:pointer}
.catbtn.on{background:var(--c);color:#fff}
.catbtn b{font-family:"JetBrains Mono",monospace}
.qin{font:600 12px/1.2 "JetBrains Mono",monospace;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:7px;padding:6px 9px;min-width:230px}
.qin:focus{outline:none;border-color:var(--plum)}
.qclr{font:600 10px/1 "JetBrains Mono",monospace;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:7px;padding:5px 8px;cursor:pointer}
.qclr:hover{color:var(--ink);border-color:var(--plum)}
.shown{margin-left:auto;font:600 12px/1 "JetBrains Mono",monospace;color:var(--dim)}
.creator{margin-top:26px}
.creator h2{font-family:"Cormorant Garamond",serif;font-weight:700;font-size:25px;margin:0 0 11px;padding-bottom:6px;border-bottom:2px solid var(--line);display:flex;align-items:baseline;gap:10px}
.ccount{font:700 12px/1 "JetBrains Mono",monospace;color:#fff;background:var(--plum);border-radius:9px;padding:2px 8px}
.csort{margin-left:auto;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.cslab{font:700 9px/1 "JetBrains Mono",monospace;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
.csbtn{font:600 10px/1 "JetBrains Mono",monospace;color:var(--dim);background:var(--bg);border:1px solid var(--line);border-radius:7px;padding:4px 8px;cursor:pointer}
.csbtn:hover{color:var(--ink);border-color:var(--plum)}
.csbtn.on{background:var(--plum);border-color:var(--plum);color:#fff}
body.flatsort .csort{display:none}
.cc{display:none}
body.flatsort .cc{display:inline-block;font:600 10px/1 "JetBrains Mono",monospace;color:#fff;background:var(--plum);border-radius:6px;padding:4px 8px;margin:6px 0 2px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:13px}
.card{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--teal);border-radius:12px;padding:13px 15px;box-shadow:2px 2px 0 rgba(43,39,35,.06);display:flex;flex-direction:column}
.card.hide{display:none}
.cn{font-family:"Cormorant Garamond",serif;font-weight:700;font-size:21px;line-height:1.12}
.cmeta{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:7px 0 3px}
.pip{width:19px;height:19px;border-radius:50%;display:grid;place-items:center;font:800 11px "JetBrains Mono",monospace;border:1px solid rgba(0,0,0,.22)}
.pending{font:600 10px/1 "JetBrains Mono",monospace;color:var(--dim);background:var(--bg);border:1px dashed var(--line);border-radius:6px;padding:3px 7px}
.cat{font:700 10px/1 "JetBrains Mono",monospace;color:var(--c);border:1px solid var(--c);border-radius:5px;padding:3px 7px}
.rec{font:600 10px/1 "JetBrains Mono",monospace;color:var(--olive);background:#EbF3E8;border:1px solid var(--olive);border-radius:5px;padding:3px 7px}
