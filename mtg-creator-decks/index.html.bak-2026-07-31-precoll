<style>
:root{--bg:#F1E6D2;--card:#FFF7E6;--ink:#1a1712;--line:#d9c9a6;--teal:#5B8C8A;--plum:#7A5A6E;--dim:#7c7059;--olive:#8A8F4F;--hot:#B85450}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;line-height:1.5}
.wrap{max-width:1100px;margin:0 auto;padding:40px 20px 120px}
.eyebrow{font:600 12px/1 "JetBrains Mono",monospace;letter-spacing:.22em;text-transform:uppercase;color:var(--plum)}
h1{font-family:"Cormorant Garamond",serif;font-weight:700;font-size:clamp(30px,6vw,52px);margin:.2em 0 .1em}
.sub{color:var(--dim);max-width:74ch;font-size:15px}
.bar{position:sticky;top:0;z-index:10;background:var(--bg);padding:12px 0 10px;margin:16px 0 6px;border-bottom:2px solid var(--line);display:flex;gap:16px;flex-wrap:wrap;align-items:center}
