// deck with green goes away". So every colour starts ON, and clicking one EXCLUDES
// every deck that needs it. The earlier version was an include-filter, where clicking
// G showed only green decks and nothing could ever hide green, which is the opposite.
var OFFC=new Set(), SELCAT=new Set(), SORT='creator';
// yyyymmdd of 7 days ago, for the "fresh" highlight
var CUTOFF=(function(){var d=new Date(Date.now()-7*864e5);
  return d.getFullYear()*10000+(d.getMonth()+1)*100+d.getDate();})();
var CARDS=Array.prototype.slice.call(document.querySelectorAll('.card'));
// _home is the creator grid a card belongs to, _ord its original position inside that
// grid, which is what the per-creator "Default" button restores.
CARDS.forEach(function(c){ c._home=c.parentNode; });
// One lowercase haystack per card: deck name, key cards, video title, and the
// creator read off its section. Built now, while every card is still inside its
// creator block, because a flat sort moves them out and closest() would miss.
CARDS.forEach(function(c){
  var sec=c.closest('.creator');
  c._s=((sec?sec.getAttribute('data-creator'):'')+' '+(c.textContent||'')).toLowerCase();
});
document.querySelectorAll('.creator .grid').forEach(function(g){
  Array.prototype.slice.call(g.children).forEach(function(c,i){ c._ord=i; });
});

// Sort inside ONE creator block. The global Sort control flattens every creator
// together; this keeps the grouping and only reorders that creator's decks.
function tcs(b){
  var sec=b.closest('.creator'), grid=sec.querySelector('.grid'), k=b.dataset.csort;
  sec.querySelectorAll('.csbtn').forEach(function(x){x.classList.toggle('on',x===b);});
  var items=Array.prototype.slice.call(grid.children);
  if(k==='def'){
    items.sort(function(a,b2){ return a._ord-b2._ord; });
  } else {
    var attr = (k==='price') ? 'data-price' : (k==='rm' ? 'data-rm' : 'data-pub');
    var desc = (k==='pub');
    // a deck with no number for this key sinks to the bottom rather than sorting as 0
    items.sort(function(a,b2){
      var av=a.getAttribute(attr), bv=b2.getAttribute(attr);
      if(av===''&&bv==='') return a._ord-b2._ord;
      if(av==='') return 1;
      if(bv==='') return -1;
      var x=parseFloat(av), y=parseFloat(bv);
      return desc ? (y-x) : (x-y);
    });
  }
  items.forEach(function(c){ grid.appendChild(c); });
}

