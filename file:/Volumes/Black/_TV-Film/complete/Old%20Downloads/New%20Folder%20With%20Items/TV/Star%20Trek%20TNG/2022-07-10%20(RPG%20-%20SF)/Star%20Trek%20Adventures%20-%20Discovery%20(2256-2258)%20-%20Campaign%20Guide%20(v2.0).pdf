<style>
:root{--cream:#f3ead3;--paper:#fbf6e9;--ink:#3b2c25;--ink-soft:#6f5b4d;--rose:#b5654a;
  --rose-deep:#9c4a36;--mustard:#e0a96d;--gold:#d9a441;--teal:#5f8475;--teal-deep:#46685b;
  --line:#e3d6b6;--shadow:rgba(59,44,37,.20);}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--cream);color:var(--ink);
  font-family:"Inter",ui-sans-serif,system-ui,-apple-system,sans-serif;
  background-image:
    radial-gradient(circle at 10% 6%,rgba(224,169,109,.18),transparent 42%),
    radial-gradient(circle at 92% 10%,rgba(95,132,117,.16),transparent 46%);}
.box{max-width:700px;margin:0 auto;padding:44px 22px;text-align:center}
.num{font-size:clamp(86px,20vw,168px);line-height:.86;font-weight:800;color:var(--rose-deep);
  letter-spacing:-.03em;text-shadow:5px 5px 0 rgba(156,74,54,.16)}
h1{font-size:clamp(22px,4vw,31px);margin:.12em 0 .22em;letter-spacing:-.01em}
p.lead{font-size:17px;color:var(--ink-soft);max-width:48ch;margin:0 auto 28px}
.links{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.lk{display:block;text-decoration:none;background:var(--paper);border:2px solid var(--ink);
  border-radius:14px;padding:13px 18px;color:var(--ink);font-weight:700;
  box-shadow:3px 3px 0 var(--shadow);transition:transform .07s,background .15s;min-width:150px}
.lk:hover{transform:translate(1px,1px);background:#fff}
.lk small{display:block;font-weight:500;font-size:12px;color:var(--ink-soft);margin-top:3px}
.kid-only{background:#fff7e6;border:2px dashed var(--gold);border-radius:14px;
  padding:14px 16px;margin:26px auto 0;max-width:50ch;font-size:1.05em}
</style>
</head>
<body>
<div class="box">
  <div class="num">404</div>
  <h1 class="grown">This page wandered off</h1>
  <p class="lead grown">The link is stale or the address has a typo. Nothing is broken, this exact page just does not exist. Pick a live door below.</p>
  <div class="kid-only"><strong>Oops!</strong> The page you wanted is not here. It may have moved, or the web address has a small typo. Tap one of the buttons to go somewhere that works.</div>
  <div class="links">
    <a class="lk" href="/">Home<small>start here</small></a>
    <a class="lk" href="/rush-fans-corpus">Rushfans Corpus<small>20 episodes, searchable</small></a>
    <a class="lk" href="/all-sites">All sites<small>everything shipped</small></a>
    <a class="lk" href="/chats">All chats<small>color-coded board</small></a>
    <a class="lk" href="/plans">Plans<small>workflow tracker</small></a>
  </div>
</div>

</body>
</html>
